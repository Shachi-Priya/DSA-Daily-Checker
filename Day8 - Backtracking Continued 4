# Problem 1:---------------------------------------------------
37. Sudoku Solver

https://leetcode.com/problems/sudoku-solver/description/

var solveSudoku = function(board) {
   // TC: O(1) - board size fixed
   // SC: O(1) - board size fixed
   function isValid(board, row, col, char){
       for(let x=0;x<9;x++){
           if(board[row][x]==char || board[x][col]==char)
               return false;

           let r=3*Math.floor(row/3)+Math.floor(x/3);
           let c=3*Math.floor(col/3)+x%3;
           if(board[r][c]===char){
               return false;
           }
       }
       return true;
   }

   function helper(board){
       for(let row=0;row<9;row++){
           for(let col=0;col<9;col++){
               if(board[row][col]=='.'){
                   for(let num=1;num<=9;num++){
                       let char=num.toString();
                       if(isValid(board, row, col, char)){
                           board[row][col]=char;
                           if(helper(board)){
                               return true;
                           }
                           board[row][col]='.';
                       }
                   }
                   return false;
               }
           }
       }
       return true; // if board is completely filled
   }

   helper(board);
};


# Problem 2:---------------------------------------------------
51. N-Queens

https://leetcode.com/problems/n-queens/description

var solveNQueens = function(n) {
    // TC: O(n!)
    // SC: O(n^2)
    let res=[];
    let board=new Array(n).fill().map(()=>new Array(n).fill('.'));

    function convertBoard(board){
        return board.map((row)=>row.join(""));
    }
    
    function isValid(row, col, board){
        //check the same col if other queens found
        for(let x=0;x<row;x++){
            if(board[x][col]==='Q')
                return false;
        }

        // check the top-left diagonal
        for(let x=row,y=col;x>=0 && y>=0;x--,y--){
            if(board[x][y]==='Q')
                return false;
        }

        // check the top-right diagonal
        for(let x=row,y=col;x>=0 && y<n;x--,y++){
            if(board[x][y]==='Q')
                return false;
        }

        return true;
    }

    function positionNextQueen(board, row){
        // if all queens are placed
        if(row===n){
            res.push(convertBoard(board));
            return;
        }

        // try placing a queen in each column of current row
        for(let col=0;col<n;col++){
            if(isValid(row, col, board)){
                board[row][col]='Q'; // place the queen
                positionNextQueen(board, row+1); // move to next row
                board[row][col]='.'; // backtrack step: remove the queen
            }
        }
    }

    positionNextQueen(board, 0);
    return res;
};


